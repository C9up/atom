{
  "name": "@c9up/atom",
  "version": "0.1.12",
  "description": "Atom — exact decimal arithmetic for the Ream ecosystem (TypeScript + Rust N-API)",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./atlas": {
      "types": "./src/atlas.ts",
      "import": "./src/atlas.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "build:rust": "cargo build --release -p atom-engine-napi",
    "build:napi": "pnpm build:rust && pnpm build:napi-types && node scripts/copy-napi.mjs",
    "build:napi-types": "node scripts/build-napi-types.mjs",
    "test": "vitest run",
    "test:rust": "cargo test -p atom-engine",
    "test:napi": "node scripts/verify-napi.mjs",
    "bench": "pnpm build && node scripts/bench.mjs",
    "build:wasm": "wasm-pack build --target web crates/atom-engine-wasm --out-dir ../../wasm",
    "lint": "biome check src/ tests/",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "tsc -p tsconfig.build.json && pnpm build:wasm && node scripts/verify-wasm.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "index.*.node",
    "scripts",
    "src",
    "wasm"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/node": "^22.19.15",
    "@vitest/coverage-v8": "^4.1.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "pnpm": {
    "//": "Pin the coverage toolchain to the version used in dev. Without a committed lockfile the standalone CI resolves fresh, and v8 branch-counting differs enough between releases to cross a threshold on its own. Overrides only apply when this package is the install root (CI), so the monorepo workspace is unaffected.",
    "overrides": {
      "@vitest/coverage-v8": "4.1.11",
      "vitest": "4.1.11"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./atlas": {
        "types": "./dist/atlas.d.ts",
        "import": "./dist/atlas.js"
      }
    },
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C9up/atom.git"
  }
}
